# Шаблон змінних середовища (COPY .env.example .env лише НА VPS).
#
# Реальні .env існують ТІЛЬКИ на VPS і розрізняються значеннями:
#   /home/onivan/cohbbot/.env      — прод: свій TELEGRAM_TOKEN, PORT=8000, своя БД
#   /home/onivan/cohbbot-dev/.env  — staging: свій TELEGRAM_TOKEN, PORT=8001, cohbbot_db
# У локальних клонах .env немає: усе, що потребує БД або запущеного сервісу,
# виконується на VPS через ssh (make test, make logs, make shell).
#
# Увага: різні боти => різні TELEGRAM_TOKEN. telegram_id користувача при цьому
# однаковий у всіх ботах (це ID користувача, а не бота).

# --- Основні ---
TELEGRAM_TOKEN=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
SPREADSHEET_ID=
WEBAPP_URL=
PORT=8000
DEBUG_DIAGNOSTICS=False
SECRET_KEY=

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
